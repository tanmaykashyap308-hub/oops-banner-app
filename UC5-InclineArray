/**
 * OOPSBannerApp - UC5
 * Prints "OOPS" in banner format using inline array initialization
 * 
 * @author Tanmay
 * @version 5.0
 */
public class OOPSBannerApp {
    public static void main(String[] args) {
        // Inline array initialization with String.join()
        String[] banner = {
            String.join(" ", "*****", "*****", "*****", "******"),
            String.join(" ", "*     *", "*     *", "*     *", "*"),
            String.join(" ", "*     *", "*     *", "*     *", "*"),
            String.join(" ", "*     *", "*     *", "*     *", "******"),
            String.join(" ", "*     *", "*     *", "        ", "*"),
            String.join(" ", "*     *", "*     *", "        ", "*"),
            String.join(" ", "*****", "*****", "        ", "******")
        };

        // Loop through array and print each line
        for (String line : banner) {
            System.out.println(line);
        }
    }
}
