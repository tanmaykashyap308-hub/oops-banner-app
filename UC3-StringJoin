/**
 * OOPSBannerApp - UC3
 * Prints "OOPS" in banner format using String.join()
 * 
 * @author TANMAY*
 * @version 3.0
 */
public class OOPSBannerApp {
    public static void main(String[] args) {
        // Each line is built using String.join() for efficiency
        System.out.println(String.join(" ", "*****", "*****", "*****", "******"));
        System.out.println(String.join(" ", "*     *", "*     *", "*     *", "*"));
        System.out.println(String.join(" ", "*     *", "*     *", "*     *", "*"));
        System.out.println(String.join(" ", "*     *", "*     *", "*     *", "******"));
        System.out.println(String.join(" ", "*     *", "*     *", "        ", "*"));
        System.out.println(String.join(" ", "*     *", "*     *", "        ", "*"));
        System.out.println(String.join(" ", "*****", "*****", "        ", "******"));
    }
}
